@page "/agents"
@attribute [Authorize(Policy = Permissions.AgentsRead)]

@using IronForge.Shared.Models.Agents.Manage
@using IronForge.Shared.Services

@inject IAgentManagementService AgentManagementService

<PageTitle>AI agents | IronForge</PageTitle>

<div class="if-page">
    <div class="if-page-head">
        <div>
            <h1>AI agents</h1>
            <p>
                The assistants included in your plan. Staff use the gym assistant under
                "AI assistant"; members use the Fitness Coach in the app. Actions that
                change money or memberships always wait for a person's approval.
            </p>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="if-alert error">@_error</div>
    }

    @if (_usage is not null)
    {
        <div class="if-card" style="margin-bottom: 16px">
            <div class="if-row">
                <strong>Usage this month</strong>
                <span class="if-spacer"></span>
                <span class="if-muted if-small">Resets @GymFormat.Date(_usage.PeriodEndUtc)</span>
            </div>
            <div style="font-size: 1.3rem; font-weight: 700; margin-top: 6px">
                @_usage.TokensUsed.ToString("N0")
                <span class="if-muted if-small" style="font-weight: 400">
                    @(_usage.MonthlyTokenLimit is { } limit ? $"of {limit:N0} tokens" : "tokens (no limit)")
                </span>
            </div>
            @if (_usage.IsExceeded)
            {
                <div class="if-alert warning" style="margin-top: 8px">
                    This month's allowance is used up. The agents answer again when it resets,
                    or ask IronForge support to raise your limit.
                </div>
            }
        </div>
    }

    @if (_agents is null)
    {
        <div class="if-loading">Loading agents…</div>
    }
    else if (_agents.Count == 0)
    {
        <div class="if-empty">Your plan does not include any AI agents.</div>
    }
    else
    {
        <div class="if-grid">
            @foreach (var agent in _agents)
            {
                <div class="if-card" style="@(agent.IsActive ? "" : "opacity: 0.7")">
                    <div class="if-card-head">
                        <h3>@agent.Name</h3>
                        <Badge Tone="@(agent.IsActive ? "success" : "")">@(agent.IsActive ? "On" : "Off")</Badge>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(agent.Description))
                    {
                        <p class="if-small">@agent.Description</p>
                    }

                    <div class="if-small if-muted">
                        Used by: @(agent.AllowedRoles.Count == 0 ? "everyone" : string.Join(", ", agent.AllowedRoles))
                        · @TokensFor(agent.AgentId).ToString("N0") tokens this month
                    </div>

                    @if (agent.Tools.Count > 0)
                    {
                        <details style="margin-top: 8px">
                            <summary class="if-small">What it can do (@agent.Tools.Count)</summary>
                            <ul class="if-small" style="margin: 6px 0 0; padding-left: 18px">
                                @foreach (var tool in agent.Tools)
                                {
                                    <li>
                                        @ToolLabel(tool.ToolName)
                                        @if (tool.RequiresApproval == true)
                                        {
                                            <span class="if-muted"> (needs approval)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    }

                    <div class="if-row" style="margin-top: 12px">
                        <span class="if-spacer"></span>
                        <AuthorizeView Policy="@Permissions.AgentsUpdate">
                            <button class="if-btn sm @(agent.IsActive ? "" : "primary")"
                                    disabled="@(_busyAgentId == agent.AgentId)"
                                    @onclick="() => ToggleAsync(agent)">
                                @(agent.IsActive ? "Turn off" : "Turn on")
                            </button>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<AgentDto>? _agents;
    private AgentUsageSummaryDto? _usage;
    private string? _error;
    private string? _busyAgentId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await AgentManagementService.GetAgentsAsync();

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            _agents = [];
            return;
        }

        _agents = result.Data!;

        // Non-fatal: the list is still useful without usage figures.
        var usage = await AgentManagementService.GetUsageAsync();
        _usage = usage.Success ? usage.Data : null;
    }

    private async Task ToggleAsync(AgentDto agent)
    {
        _busyAgentId = agent.AgentId;
        _error = null;

        var result = await AgentManagementService.SetActiveAsync(agent.AgentId, !agent.IsActive);
        _busyAgentId = null;

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        await LoadAsync();
    }

    private long TokensFor(string agentId) =>
        _usage?.Agents.FirstOrDefault(x => x.AgentId == agentId)?.TotalTokens ?? 0;

    // search_members -> Search members
    private static string ToolLabel(string toolName)
    {
        var words = toolName.Replace('_', ' ');
        return words.Length == 0 ? words : char.ToUpperInvariant(words[0]) + words[1..];
    }
}
