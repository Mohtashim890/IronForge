@page "/settings"
@attribute [Authorize(Policy = Permissions.GymSettingsManage)]
@inject GymApiClient Gym
@inject NavigationManager Navigation

<PageTitle>Gym settings | IronForge</PageTitle>

<div class="if-page" style="max-width: 980px">
    <div class="if-page-head">
        <div>
            <h1>Gym settings</h1>
            <p>Contact details, billing rules, joining and payments.</p>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="if-alert success">@_message</div>
    }

    @if (_error is not null)
    {
        <div class="if-alert error">@_error</div>
    }

    @if (_settings is null)
    {
        <div class="if-loading">Loading settings…</div>
    }
    else
    {
        <div class="if-grid-2">
            <div class="if-card">
                <div class="if-card-head"><h2>Join code</h2></div>
                <p class="if-muted if-small">New members enter this code in the IronForge app to request to join @_settings.GymName.</p>
                <div style="font-size: 2rem; font-weight: 800; letter-spacing: 0.15em" class="if-mono">@_settings.JoinCode</div>
                <button class="if-btn" style="margin-top: 10px" disabled="@_busy" @onclick="RegenerateAsync">Create a new code</button>
                <p class="if-muted if-small">The old code stops working immediately.</p>
            </div>

            <div class="if-card">
                <div class="if-card-head">
                    <h2>Online payments</h2>
                    <a class="if-small" href="/settings/payments">Set up →</a>
                </div>
                @if (_settings.OnlinePaymentsAvailable && _settings.PaymentsSimulated)
                {
                    <div class="if-alert info">Members see a <strong>test checkout</strong>: no money moves (demo platform).</div>
                }
                else if (_settings.OnlinePaymentsAvailable)
                {
                    <div class="if-alert success">Members can pay their invoices in the app, straight into your payment provider account.</div>
                }
                else
                {
                    <p class="if-muted if-small">
                        Members can't pay in the app yet. Connect your HitPay or Safepay account under
                        <a href="/settings/payments">Online payments</a>. Until then they pay at the front desk or by bank transfer,
                        and you record it on the <a href="/billing/invoices">Invoices</a> page.
                    </p>
                }
            </div>
        </div>

        <div class="if-card" style="margin-top: 16px">
            <div class="if-card-head">
                <h2>Check-in methods</h2>
                <a class="if-small" href="/checkin-devices">Check-in devices →</a>
            </div>
            <p class="if-muted if-small" style="margin-top: 0">
                Staff can always check a member in by name at the front desk. Fingerprint terminals are set up under
                <a href="/checkin-devices">Check-in devices</a>. Changes here apply at once, in the app, at the front desk and on every kiosk.
            </p>

            <label class="if-check-option">
                <input type="checkbox" @bind="_memberPass" />
                <span>
                    <strong>Member pass (QR code in the app)</strong>
                    <span class="if-small if-muted">
                        Members show a QR code from the app that changes every 30 seconds. Staff at the front desk or a kiosk scan it,
                        and staff see the member's photo. Works without internet on the phone. Off: the Pass tab and the kiosk are switched off.
                    </span>
                </span>
            </label>

            <label class="if-check-option">
                <input type="checkbox" @bind="_phoneUnlock" />
                <span>
                    <strong>Ask for the phone's fingerprint, face or screen lock</strong>
                    <span class="if-small if-muted">
                        Before the app shows the pass, the member confirms it's them on their phone.
                        The pass then hides again after a minute. Stops a member handing the phone to a friend.
                        A pass also works on one phone at a time: moving it resets it and emails the member.
                    </span>
                </span>
            </label>

            @if (!_memberPass)
            {
                <div class="if-alert info" style="margin: 10px 0 0">With the pass off, members check in by name at the front desk, or with a fingerprint terminal.</div>
            }

            <button class="if-btn primary" style="margin-top: 12px" disabled="@(_busy || !CheckInChanged)" @onclick="SaveCheckInMethodsAsync">Save check-in methods</button>
        </div>

        <div class="if-card" style="margin-top: 16px">
            <div class="if-card-head"><h2>Gym details and billing rules</h2></div>

            <div class="if-form-grid">
                <div class="if-field"><label>Address</label><input @bind="_form.Address" /></div>
                <div class="if-field"><label>Phone</label><input @bind="_form.Phone" /></div>
                <div class="if-field"><label>Contact email</label><input type="email" @bind="_form.ContactEmail" /></div>
                <div class="if-field"><label>Currency</label><input @bind="_form.Currency" maxlength="3" /></div>
                <div class="if-field"><label>Time zone</label><input @bind="_form.TimeZoneId" placeholder="Asia/Karachi" /></div>
            </div>

            <div class="if-form-grid">
                <div class="if-field">
                    <label>Issue invoices this many days before the billing date</label>
                    <input type="number" min="0" max="30" @bind="_form.InvoiceLeadDays" />
                </div>
                <div class="if-field">
                    <label>Remind this many days before the due date</label>
                    <input type="number" min="0" max="30" @bind="_form.ReminderDaysBeforeDue" />
                </div>
                <div class="if-field">
                    <label>Remind again after the due date (days, comma-separated)</label>
                    <input @bind="_afterDue" placeholder="1, 7" />
                </div>
                <div class="if-field">
                    <label>Expire memberships unpaid for more than (days)</label>
                    <input type="number" min="0" max="90" @bind="_form.GracePeriodDays" />
                </div>
            </div>

            <div class="if-field">
                <label>Payment instructions for members</label>
                <textarea rows="3" maxlength="1000" @bind="_form.PaymentInstructions"
                          placeholder="e.g. Pay cash at the front desk, or transfer to Meezan Bank, IBAN PK00 MEZN 0000 0000 0000, title Iron Paradise Gym. Use your invoice number as the reference."></textarea>
                <span class="if-small if-muted">Shown in the member app next to unpaid invoices.</span>
            </div>

            <button class="if-btn primary" disabled="@_busy" @onclick="SaveAsync">Save settings</button>
        </div>
    }
</div>

@code {
    private GymSettingsDto? _settings;
    private UpdateGymSettingsRequest _form = new();
    private string _afterDue = "";
    private bool _memberPass;
    private bool _phoneUnlock;

    private bool CheckInChanged =>
        _settings is not null &&
        (_memberPass != _settings.MemberPassCheckInEnabled ||
         _phoneUnlock != _settings.RequirePhoneUnlock);
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var result = await Gym.GetSettingsAsync();

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        Apply(result.Data!);
    }

    private void Apply(GymSettingsDto settings)
    {
        _settings = settings;
        _form = new UpdateGymSettingsRequest
        {
            Address = settings.Address,
            Phone = settings.Phone,
            ContactEmail = settings.ContactEmail,
            Currency = settings.Currency,
            TimeZoneId = settings.TimeZoneId,
            InvoiceLeadDays = settings.InvoiceLeadDays,
            ReminderDaysBeforeDue = settings.ReminderDaysBeforeDue,
            ReminderDaysAfterDue = settings.ReminderDaysAfterDue,
            GracePeriodDays = settings.GracePeriodDays,
            PaymentInstructions = settings.PaymentInstructions
        };
        _afterDue = string.Join(", ", settings.ReminderDaysAfterDue);
        _memberPass = settings.MemberPassCheckInEnabled;
        _phoneUnlock = settings.RequirePhoneUnlock;
    }

    private Task SaveCheckInMethodsAsync() =>
        RunAsync(
            () => Gym.UpdateCheckInMethodsAsync(new UpdateCheckInMethodsRequest
            {
                MemberPassEnabled = _memberPass,
                RequirePhoneUnlock = _phoneUnlock
            }),
            "Check-in methods saved.");

    private async Task SaveAsync()
    {
        _form.ReminderDaysAfterDue = _afterDue
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => int.TryParse(x, out var day) ? day : 0)
            .Where(x => x > 0)
            .ToList();

        await RunAsync(() => Gym.UpdateSettingsAsync(_form), "Settings saved.");
    }

    private Task RegenerateAsync() => RunAsync(Gym.RegenerateJoinCodeAsync, "New join code created.");

    private async Task RunAsync(Func<CancellationToken, Task<ServiceResult<GymSettingsDto>>> action, string success)
    {
        _busy = true;
        _error = null;
        _message = null;

        var result = await action(default);

        _busy = false;

        if (result.Success)
        {
            Apply(result.Data!);
            _message = success;
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    private Task RunAsync(Func<Task<ServiceResult<GymSettingsDto>>> action, string success) =>
        RunAsync(_ => action(), success);
}
