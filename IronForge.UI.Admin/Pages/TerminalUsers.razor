@page "/access/terminal-users"
@attribute [Authorize(Policy = Permissions.GymMembersRead)]
@inject GymApiClient Gym

<PageTitle>Fingerprint users | IronForge</PageTitle>

<div class="if-page">
    <p><a href="/checkin-devices" class="if-small">← Check-in devices</a></p>

    <div class="if-page-head">
        <div>
            <h1>Fingerprint check-in</h1>
            <p>People enrolled on the gym's ZKTeco terminals. Link each one to a member: IronForge then tells the terminals who may enter.</p>
        </div>
        <AuthorizeView Policy="@Permissions.GymMembersManage">
            <button class="if-btn" @onclick="() => _adding = true">Add a member to the terminals</button>
        </AuthorizeView>
    </div>

    @if (_error is not null)
    {
        <div class="if-alert error">@_error</div>
    }

    @if (_message is not null)
    {
        <div class="if-alert success">@_message</div>
    }

    @if (_users is null)
    {
        <div class="if-loading">Loading…</div>
    }
    else
    {
        var waiting = _users.Where(x => x.MemberId is null && !x.Ignored).ToList();
        var linked = _users.Where(x => x.MemberId is not null).ToList();
        var ignored = _users.Where(x => x.Ignored).ToList();
        var suggested = waiting.Count(x => x.SuggestedMemberId is not null);
        var connected = _terminals?.Any(x => x.IsPaired) == true;
        var inSync = _terminals?.Sum(x => x.UsersInSync) ?? 0;
        var pending = _terminals?.Sum(x => x.UsersPending) ?? 0;

        <div class="if-card" style="margin-bottom: 16px">
            <div class="if-card-head"><h2>How fingerprint check-in works</h2></div>
            <ol class="if-steps">
                <li class="@(Done(_hasMembers))">
                    <strong>Members are in IronForge.</strong>
                    Add them one by one or with <a href="/members/import">Import members</a>. Fingerprints only ever link to existing members.
                </li>
                <li class="@(Done(connected))">
                    <strong>A terminal is connected.</strong>
                    Register it by serial number under <a href="/checkin-devices">Check-in devices</a> and point it at IronForge.
                    @if (_terminals is not null)
                    {
                        <span class="if-muted">@(_terminals.Count == 0 ? "No terminal registered yet." : connected ? $"{_terminals.Count(x => x.IsPaired)} connected." : "Registered, waiting for the terminal to call in.")</span>
                    }
                </li>
                <li class="@(Done(_users.Count > 0))">
                    <strong>The terminal sends who is enrolled</strong> (user number, name, whether a finger exists, never the fingerprint).
                    <span class="if-muted">@_users.Count received.</span>
                </li>
                <li class="@(Done(_users.Count > 0 && waiting.Count == 0))">
                    <strong>Link each person to a member</strong> below; mark staff as "Not a member".
                    <span class="if-muted">@(waiting.Count == 0 ? "Nobody waiting." : $"{waiting.Count} waiting.")</span>
                </li>
                <li class="@(Done(linked.Count > 0 && pending == 0 && inSync > 0))">
                    <strong>The terminals receive each member's access</strong>: allowed until a date, or refused. They then decide at the door, also offline.
                    @if (_terminals is not null)
                    {
                        <span class="if-muted">@inSync in step@(pending > 0 ? $", {pending} being sent" : "").</span>
                    }
                </li>
                <li class="@(Done(linked.Any(x => x.LastEntryAtUtc is not null)))">
                    <strong>Members enter with their finger.</strong> Each entry appears as a visit on the <a href="/checkins">Front desk</a>.
                </li>
            </ol>
        </div>

        <div class="if-grid">
            <StatTile Label="Waiting to be linked" Value="@waiting.Count.ToString()" Tone="@(waiting.Count > 0 ? "warning" : null)" />
            <StatTile Label="Linked members" Value="@linked.Count.ToString()" Tone="success" />
            <StatTile Label="Not members (staff)" Value="@ignored.Count.ToString()" />
            <StatTile Label="With a fingerprint" Value="@_users.Count(x => x.HasFingerprint).ToString()" Sub="templates stay on the terminal" />
        </div>

        <div class="if-card" style="margin-top: 16px">
            <div class="if-card-head">
                <h2>Waiting to be linked</h2>
                @if (suggested > 0)
                {
                    <AuthorizeView Policy="@Permissions.GymMembersManage">
                        <button class="if-btn primary sm" disabled="@_busy" @onclick="LinkSuggestedAsync">Link all @suggested name matches</button>
                    </AuthorizeView>
                }
            </div>
            @if (waiting.Count == 0)
            {
                <div class="if-empty">Nobody is waiting. New people enrolled on a terminal appear here.</div>
            }
            else
            {
                <table class="if-table">
                    <thead><tr><th>User no.</th><th>Name on the terminal</th><th>Finger</th><th>Suggested member</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var user in waiting)
                        {
                            <tr>
                                <td class="if-mono">@user.Pin</td>
                                <td>@(user.TerminalName ?? "—")</td>
                                <td>@(user.HasFingerprint ? "✓" : "—")</td>
                                <td>
                                    @if (user.SuggestedMemberId is { } memberId)
                                    {
                                        <a href="@($"/members/{memberId}")">@user.SuggestedMemberName</a>
                                    }
                                    else
                                    {
                                        <span class="if-muted">no exact name match</span>
                                    }
                                </td>
                                <td style="text-align: right; white-space: nowrap">
                                    <AuthorizeView Policy="@Permissions.GymMembersManage">
                                        @if (user.SuggestedMemberId is { } id)
                                        {
                                            <button class="if-btn sm primary" disabled="@_busy" @onclick="() => LinkAsync(user, id)">Link</button>
                                        }
                                        <button class="if-btn sm" disabled="@_busy" @onclick="() => Choose(user)">Choose member</button>
                                        <button class="if-btn sm ghost" disabled="@_busy" title="Staff or anyone else who is not a member: left as is on the terminal" @onclick="() => SetIgnoredAsync(user, true)">Not a member</button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="if-card" style="margin-top: 16px">
            <div class="if-card-head"><h2>Linked members</h2></div>
            @if (linked.Count == 0)
            {
                <div class="if-empty">No members linked yet.</div>
            }
            else
            {
                <table class="if-table">
                    <thead><tr><th>User no.</th><th>Member</th><th>On the terminals</th><th>Last entry</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var user in linked)
                        {
                            <tr>
                                <td class="if-mono">@user.Pin @(user.HasFingerprint ? "· ✓" : "")</td>
                                <td>
                                    <a href="@($"/members/{user.MemberId}")">@user.MemberName</a>
                                    @if (user.MemberStatus is { } status)
                                    {
                                        <span> </span><Badge Tone="@GymFormat.Tone(status)">@status</Badge>
                                    }
                                </td>
                                <td>
                                    @if (user.AccessEnabled is null)
                                    {
                                        <span class="if-muted">sent at the next poll</span>
                                    }
                                    else if (user.AccessEnabled == true)
                                    {
                                        <span>May enter until @GymFormat.Date(user.ValidUntil)</span>
                                    }
                                    else
                                    {
                                        <Badge Tone="danger">Refused</Badge>
                                    }
                                </td>
                                <td>@(user.LastEntryAtUtc is { } at ? GymFormat.Ago(at) : "—")</td>
                                <td style="text-align: right">
                                    <AuthorizeView Policy="@Permissions.GymMembersManage">
                                        <button class="if-btn sm" disabled="@_busy" @onclick="() => LinkAsync(user, null)">Unlink</button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="if-small if-muted" style="margin: 10px 0 0">
                    The end date lets a terminal keep deciding when it is offline: it is the end of the grace period of the next payment.
                    Paying, freezing or expiring updates it at the terminal's next poll (within a minute).
                </p>
            }
        </div>

        @if (ignored.Count > 0)
        {
            <div class="if-card" style="margin-top: 16px">
                <div class="if-card-head"><h2>Not members</h2></div>
                <ul class="if-list">
                    @foreach (var user in ignored)
                    {
                        <li>
                            <span class="if-mono">@user.Pin</span>
                            <span style="flex: 1">@(user.TerminalName ?? "—")</span>
                            <AuthorizeView Policy="@Permissions.GymMembersManage">
                                <button class="if-btn sm ghost" disabled="@_busy" @onclick="() => SetIgnoredAsync(user, false)">Undo</button>
                            </AuthorizeView>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

<Modal Open="@(_choosing is not null)" OpenChanged="open => { if (!open) _choosing = null; }" Title="@($"Link terminal user {_choosing?.Pin}")">
    <ChildContent>
        <p class="if-small if-muted">Name on the terminal: <strong>@(_choosing?.TerminalName ?? "—")</strong></p>
        <MemberSearch OnPicked="member => LinkAsync(_choosing!, member.Id)" />
    </ChildContent>
</Modal>

<Modal @bind-Open="_adding" Title="Add a member to the terminals">
    <ChildContent>
        <p class="if-small if-muted">The member gets the next free user number. Then enrol their finger on the terminal under that number.</p>
        <MemberSearch OnPicked="CreateAsync" />
    </ChildContent>
</Modal>

@code {
    private List<TerminalUserDto>? _users;
    private TerminalUserDto? _choosing;
    private bool _adding;
    private bool _busy;
    private string? _error;
    private string? _message;

    private List<CheckInDeviceDto>? _terminals;
    private bool _hasMembers;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Gym.GetTerminalUsersAsync();

        _users = result.Data ?? [];
        _error = result.Success ? null : result.ErrorMessage;

        // Terminals are visible to admins only; trainers see the people and the links.
        var devices = await Gym.GetCheckInDevicesAsync();
        _terminals = devices.Success
            ? devices.Data!.Where(x => x.Kind == CheckInDeviceKind.ZkTecoTerminal && !x.IsRevoked).ToList()
            : null;

        _hasMembers = ((await Gym.GetMembersAsync(new MemberQuery { PageSize = 1 })).Data?.TotalCount ?? 0) > 0;
    }

    private static string Done(bool done) => done ? "done" : "";

    private void Choose(TerminalUserDto user) => _choosing = user;

    private async Task LinkAsync(TerminalUserDto user, int? memberId)
    {
        _choosing = null;

        await RunAsync(
            () => Gym.LinkTerminalUserAsync(user.Id, memberId),
            memberId is null
                ? $"User {user.Pin} unlinked. The terminals stop letting them in at their next poll."
                : $"User {user.Pin} linked. The terminals get their access at the next poll.");
    }

    private async Task LinkSuggestedAsync()
    {
        _busy = true;
        var result = await Gym.LinkSuggestedTerminalUsersAsync();
        _busy = false;

        _error = result.Success ? null : result.ErrorMessage;
        _message = result.Success ? $"{result.Data} terminal users linked by name." : null;
        await LoadAsync();
    }

    private Task SetIgnoredAsync(TerminalUserDto user, bool ignored) =>
        RunAsync(
            () => Gym.SetTerminalUserIgnoredAsync(user.Id, ignored),
            ignored ? $"User {user.Pin} marked as not a member: left as is on the terminals." : $"User {user.Pin} is waiting to be linked again.");

    private async Task CreateAsync(MemberSummaryDto member)
    {
        _adding = false;
        _busy = true;
        var result = await Gym.CreateTerminalUserAsync(member.Id);
        _busy = false;

        _error = result.Success ? null : result.ErrorMessage;
        _message = result.Success
            ? $"{member.FullName} is user number {result.Data!.Pin}. On the terminal: Menu → User Mgt. → find {result.Data.Pin} → enrol a fingerprint."
            : null;
        await LoadAsync();
    }

    private async Task RunAsync(Func<Task<ServiceResult<TerminalUserDto>>> action, string success)
    {
        _busy = true;
        var result = await action();
        _busy = false;

        _error = result.Success ? null : result.ErrorMessage;
        _message = result.Success ? success : null;
        await LoadAsync();
    }
}
