<div class="nav-item">
    <PrefixNavLink class="nav-link" href="@Href" Except="Except">
        <span class="nav-icon" aria-hidden="true">@Icon</span>
        <span>@Text</span>
    </PrefixNavLink>
</div>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    [Parameter] public string Icon { get; set; } = "•";

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Sub-paths that have their own sidebar entry, so this one stays inactive there.</summary>
    [Parameter] public string[]? Except { get; set; }
}
