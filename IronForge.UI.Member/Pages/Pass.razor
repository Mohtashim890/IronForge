@page "/pass"
@attribute [Authorize]
@implements IDisposable
@inject MemberApiClient Me
@inject IAuthService AuthService
@inject IMemberPassStore PassStore
@inject IPhoneUnlock PhoneUnlock

<PageTitle>My pass | IronForge</PageTitle>

<h1 style="font-size: 1.4rem">My pass</h1>

@if (_loading)
{
    <div class="if-loading">Loading…</div>
}
else
{
    @if (_error is not null)
    {
        <div class="if-alert error">@_error</div>
    }

    @if (_status is not null)
    {
        <div class="if-alert success">@_status</div>
    }

    @if (_onAnotherPhone)
    {
        <div class="m-card">
            <strong>Your pass is on another phone</strong>
            <p class="if-small if-muted" style="margin: 4px 0 10px">
                A pass works on one phone at a time. Moving it here stops the pass on the other phone,
                and we'll email you about it.
            </p>
            <button class="if-btn primary block" disabled="@_busy" @onclick="MoveHereAsync">Move my pass to this phone</button>
        </div>
    }

    @if (_pass is not null)
    {
        <div class="m-card m-pass">
            <div class="if-row" style="justify-content: center; gap: 12px; flex-wrap: nowrap">
                @if (_pass.PhotoDataUrl is not null)
                {
                    <img class="m-pass-photo" src="@_pass.PhotoDataUrl" alt="" />
                }
                else
                {
                    <span class="if-avatar" style="width: 72px; height: 72px; font-size: 1.4rem">@GymFormat.Initials(_pass.FullName)</span>
                }
                <div style="text-align: left">
                    <div style="font-weight: 700; font-size: 1.15rem">@_pass.FullName</div>
                    <div class="if-muted if-small">@_pass.GymName</div>
                    <Badge Tone="@GymFormat.Tone(_pass.Status)">@_pass.Status</Badge>
                </div>
            </div>

            @if (IsShowing)
            {
                <div class="m-pass-qr" role="img" aria-label="Your check-in pass">@((MarkupString)_svg)</div>

                <div class="m-pass-timer" aria-hidden="true"><span style="width: @(_remainingPercent)%"></span></div>
                <p class="if-small if-muted" style="margin: 8px 0 0">
                    Show this pass at the front desk or hold it up to the kiosk camera.
                    It changes every @_pass.StepSeconds seconds, so screenshots don't work.
                    @if (_pass.RequirePhoneUnlock)
                    {
                        <span>It hides again in @SecondsLeft s.</span>
                    }
                </p>
            }
            else
            {
                <div class="m-pass-locked">
                    <span class="m-pass-lock" aria-hidden="true">🔒</span>
                    <p class="if-small if-muted" style="margin: 0 0 10px">
                        Your gym asks you to confirm it's you, with your fingerprint, face or screen lock.
                        Don't hand your phone to anyone else to get in.
                    </p>
                    <button class="if-btn primary block" disabled="@_busy" @onclick="ShowPassAsync">Show my pass</button>
                </div>
            }

            @if (_unlockNote is not null)
            {
                <div class="if-alert info" style="margin: 12px 0 0">@_unlockNote</div>
            }

            @if (_offline)
            {
                <div class="if-alert info" style="margin: 12px 0 0">You're offline. The pass still works.</div>
            }

            @if (_pass.Status != MemberStatus.Active)
            {
                <div class="if-alert warning" style="margin: 12px 0 0">
                    Your membership is @_pass.Status.ToString().ToLowerInvariant(): the gym will not let you in. <a href="/membership">See membership</a>
                </div>
            }
        </div>

        <div class="m-card">
            <strong>Lost your phone, or someone has your pass?</strong>
            <p class="if-small if-muted" style="margin: 4px 0 10px">Resetting stops the old pass working on every phone.</p>
            @if (_confirmReset)
            {
                <div class="if-row">
                    <button class="if-btn danger" disabled="@_busy" @onclick="ResetAsync">Yes, reset my pass</button>
                    <button class="if-btn" @onclick="() => _confirmReset = false">Cancel</button>
                </div>
            }
            else
            {
                <button class="if-btn" disabled="@(_busy || _offline)" @onclick="() => _confirmReset = true">Reset my pass</button>
            }
        </div>
    }

    @if (_passOff)
    {
        <div class="m-card if-empty">Your gym does not use the member pass. Check in at the front desk, or with your fingerprint if the gym has a fingerprint terminal.</div>
    }
}

@code {
    /// <summary>After an unlock the pass shows this long, then the member unlocks again.</summary>
    private static readonly TimeSpan ShowFor = TimeSpan.FromSeconds(60);

    private MemberPassDto? _pass;
    private string _phoneId = "";
    private byte[] _secret = [];
    private TimeSpan _clockOffset;
    private long _step = -1;
    private string _svg = "";
    private double _remainingPercent = 100;
    private Timer? _timer;
    private DateTime? _showingUntil;
    private bool _loading = true;
    private bool _passOff;
    private bool _requireUnlock = true;
    private bool _onAnotherPhone;
    private bool _offline;
    private bool _busy;
    private bool _confirmReset;
    private string? _error;
    private string? _status;
    private string? _unlockNote;

    private bool IsShowing => _pass is not null && (!_pass.RequirePhoneUnlock || _showingUntil > DateTime.UtcNow);

    private int SecondsLeft => _showingUntil is { } until ? Math.Max(0, (int)(until - DateTime.UtcNow).TotalSeconds) : 0;

    protected override async Task OnInitializedAsync()
    {
        _phoneId = await PassStore.GetPhoneIdAsync();

        var membership = await Me.GetMembershipAsync();

        if (membership.Success)
        {
            var me = membership.Data!;
            _requireUnlock = me.RequirePhoneUnlock;

            if (me.MemberPassCheckInEnabled)
            {
                await LoadPassAsync();
            }
            else
            {
                // The gym turned the pass off: forget the secret on this phone.
                _passOff = true;
                await PassStore.ClearAsync();
            }
        }
        else if (membership.StatusCode == 503 && await CachedAsync() is { } cached)
        {
            // No connection: the pass is computed on the phone.
            _offline = true;
            Use(cached, fresh: false);
        }
        else
        {
            _error = membership.ErrorMessage;
        }

        _loading = false;
        _timer = new Timer(_ => InvokeAsync(Tick), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async Task LoadPassAsync()
    {
        var result = await Me.GetPassAsync(_phoneId);

        if (result.Success)
        {
            _onAnotherPhone = false;
            await PassStore.SaveAsync(result.Data!);
            Use(result.Data!, fresh: true);
        }
        else if (result.StatusCode == MemberApiClient.PassOnAnotherPhone)
        {
            // Never show a pass this phone is not the home of.
            _onAnotherPhone = true;
            _pass = null;
            await PassStore.ClearAsync();
        }
        else if (result.StatusCode == 503 && await CachedAsync() is { } cached)
        {
            _offline = true;
            Use(cached, fresh: false);
        }
        else
        {
            // E.g. 409: not approved yet, or the gym switched the pass off meanwhile.
            _error = result.ErrorMessage;
        }
    }

    private async Task<MemberPassDto?> CachedAsync()
    {
        var gym = await AuthService.GetActiveTenantAsync();
        return gym is null ? null : await PassStore.GetAsync(gym.TenantId);
    }

    private void Use(MemberPassDto pass, bool fresh)
    {
        _pass = pass;
        _secret = Convert.FromBase64String(pass.Secret);
        _step = -1;
        _showingUntil = null;

        // Codes follow the server's clock, in case the phone's is off.
        _clockOffset = fresh ? pass.IssuedAtUtc - DateTime.UtcNow : TimeSpan.Zero;
    }

    /// <summary>
    /// The phone's owner check before the pass or a scan. Unlocked, or a
    /// phone that cannot check (shown with a note), goes ahead; a phone with
    /// no screen lock at all does not, as anyone holding it could use the pass.
    /// </summary>
    private async Task<bool> ConfirmOwnerAsync(string reason)
    {
        _unlockNote = null;

        if (!_requireUnlock)
            return true;

        switch (await PhoneUnlock.UnlockAsync(reason))
        {
            case PhoneUnlockResult.Unlocked:
                return true;

            case PhoneUnlockResult.NotSupported:
                _unlockNote = "This device cannot confirm it's you; staff may check your photo.";
                return true;

            case PhoneUnlockResult.NotSetUp:
                _error = "Set a screen lock (PIN, fingerprint or face) on this phone to use your gym pass.";
                return false;

            default:
                _error = "Not confirmed. Try again.";
                return false;
        }
    }

    private async Task ShowPassAsync()
    {
        _error = null;
        _busy = true;

        if (await ConfirmOwnerAsync("Show your gym pass"))
        {
            _showingUntil = DateTime.UtcNow + ShowFor;
            _step = -1;
            Tick();
        }

        _busy = false;
    }

    private void Tick()
    {
        if (_pass is null || !IsShowing)
        {
            // Hidden: drop the drawn code so nothing old stays on screen.
            _svg = "";
            _step = -1;
            StateHasChanged();
            return;
        }

        var now = DateTimeOffset.UtcNow + _clockOffset;
        var step = MemberPassCode.StepAt(now, _pass.StepSeconds);

        if (step != _step)
        {
            _step = step;
#pragma warning disable CA1416 // The member app runs on MAUI, not in a browser.
            var code = MemberPassCode.Create(_secret, _pass.TenantId, _pass.MemberId, _pass.KeyVersion, step);
#pragma warning restore CA1416
            _svg = QrSvg.Render(code);
        }

        var elapsed = now.ToUnixTimeSeconds() % _pass.StepSeconds;
        _remainingPercent = 100.0 * (_pass.StepSeconds - elapsed) / _pass.StepSeconds;

        StateHasChanged();
    }

    private async Task MoveHereAsync()
    {
        _error = null;

        if (!await ConfirmOwnerAsync("Move your gym pass to this phone"))
            return;

        _busy = true;
        var result = await Me.MovePassHereAsync(_phoneId);
        _busy = false;

        if (result.Success)
        {
            _onAnotherPhone = false;
            await PassStore.SaveAsync(result.Data!);
            Use(result.Data!, fresh: true);
            _status = "Your pass is on this phone now. The pass on your other phone no longer works.";
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    private async Task ResetAsync()
    {
        _confirmReset = false;

        if (!await ConfirmOwnerAsync("Reset your gym pass"))
            return;

        _busy = true;
        var result = await Me.ResetPassAsync(_phoneId);
        _busy = false;

        if (result.Success)
        {
            await PassStore.SaveAsync(result.Data!);
            Use(result.Data!, fresh: true);
            _status = "Your pass was reset. Only this new pass works now.";
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    public void Dispose() => _timer?.Dispose();
}
