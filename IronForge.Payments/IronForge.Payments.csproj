<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Online payment providers (HitPay, Safepay, the simulated test checkout).
    Each implements IPaymentProvider from IronForge.Application; nothing else
    in the solution knows a provider's API.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IronForge.Application\IronForge.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IronForge.Application.Tests" />
  </ItemGroup>

</Project>
