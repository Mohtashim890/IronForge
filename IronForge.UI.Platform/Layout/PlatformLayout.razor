@inherits LayoutComponentBase
@attribute [Authorize(Policy = Permissions.PlatformTenantsManage)]

@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="platform-theme pf-shell @(_menuOpen ? "menu-open" : "")">
    <aside class="pf-sidebar">
        <a class="pf-brand" href="/">
            <span class="pf-mark">⚒</span>
            <span>IronForge<small>Platform console</small></span>
        </a>

        <nav class="pf-nav" @onclick="() => _menuOpen = false">
            <NavLink href="/" Match="NavLinkMatch.All"><span>◉</span> Overview</NavLink>
            <NavLink href="/tenants"><span>🏢</span> Gyms</NavLink>
            <NavLink href="/catalog"><span>☰</span> Plans &amp; agents</NavLink>
            <NavLink href="/audit"><span>≡</span> Audit log</NavLink>
        </nav>

        <div class="pf-sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="pf-user">
                        <span class="if-avatar">@GymFormat.Initials(context.User.Identity?.Name)</span>
                        <span>@context.User.Identity?.Name</span>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button class="if-btn sm block" @onclick="SignOutAsync">Sign out</button>
        </div>
    </aside>

    <div class="pf-main">
        <header class="pf-topbar">
            <button class="if-btn sm pf-menu" aria-label="Menu" @onclick="() => _menuOpen = !_menuOpen">☰</button>
            <span class="if-muted">Platform operator</span>
        </header>

        <main class="pf-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _menuOpen;

    private async Task SignOutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
