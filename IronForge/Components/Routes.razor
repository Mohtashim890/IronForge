@using IronForge.Shared.Pages

<Microsoft.AspNetCore.Components.Authorization.CascadingAuthenticationState>
    <Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)"
            AdditionalAssemblies="new[] { typeof(IronForge.Shared.Pages.Login).Assembly, typeof(IronForge.UI.Member.Pages.Home).Assembly }">
        <Found Context="routeData">
            <Microsoft.AspNetCore.Components.Authorization.AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(IronForge.UI.Member.Layout.MemberLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p class="if-loading" style="padding: 24px">Loading…</p>
                </Authorizing>
            </Microsoft.AspNetCore.Components.Authorization.AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</Microsoft.AspNetCore.Components.Authorization.CascadingAuthenticationState>
