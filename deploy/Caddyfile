(base_security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

(security_headers) {
    import base_security_headers
    header Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

# The gym dashboard reads member passes with the camera (front desk, /kiosk).
(security_headers_camera) {
    import base_security_headers
    header Permissions-Policy "camera=(self), microphone=(), geolocation=()"
}

# Gym admin dashboard.
app.mohtashim.dev {
    import security_headers_camera
    reverse_proxy ironforge-web:8080
}

www.mohtashim.dev {
    redir https://mohtashim.dev{uri} permanent
}

# Platform operator console.
platform.mohtashim.dev {
    import security_headers
    reverse_proxy ironforge-platform:8080
}

mcp-client.mohtashim.dev {
    import security_headers
    reverse_proxy ironforge-mcp-client:8080
}

mcp.mohtashim.dev {
    import security_headers
    reverse_proxy ironforge-mcp:8080
}

# ZKTeco fingerprint terminals (push protocol). Many models speak plain HTTP
# only, so their fixed paths are served on port 80 too; everything else on
# this host still redirects to HTTPS. Prefer terminals with HTTPS (port 443).
http://api.mohtashim.dev {
    handle /iclock/* {
        reverse_proxy ironforge-api:8080
    }

    handle {
        redir https://api.mohtashim.dev{uri} permanent
    }
}

# API (mobile app, web apps, payment provider webhooks and return pages).
api.mohtashim.dev {
    import security_headers
    reverse_proxy ironforge-api:8080
}
