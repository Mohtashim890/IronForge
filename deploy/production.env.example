ASPNETCORE_ENVIRONMENT="Production"

ConnectionStrings__DefaultConnection=

JwtSettings__Key=

# Optional: master key for member check-in passes (32+ characters). Empty uses the JWT key.
CheckIns__PassSigningKey=

AISettings__ApiKey=

OpenTelemetry__Otlp__Headers=

IRONFORGE_IMAGE_TAG=

ApiSettings__BaseUrl=

McpSettings__ServerUrl=

Invitations__AcceptUrl=

# Optional: key that encrypts authenticator-app secrets (32+ characters). Empty uses the JWT key;
# changing it later means every admin needs a two-factor reset (IronForge.Migrator --reset-two-factor).
TwoFactor__EncryptionKey=
# Gym admins and platform operators must use an authenticator app. Set false only on a demo deployment.
TwoFactor__RequiredForAdmins=true

# Card payments. With no provider, members pay at the front desk or by bank transfer
# (the app shows the gym's payment instructions) and staff record the payment.
Stripe__SecretKey=
Stripe__WebhookSecret=
# Never true with real gyms: members could "pay" without money moving.
Payments__AllowSimulated=false

# Database backups (deploy/BACKUPS.md). A libpq URL on the direct connection (port 5432, not the pooler).
BACKUP_DATABASE_URL=
BACKUP_KEEP_DAYS=14
# Optional: a URL pinged after every successful backup (e.g. healthchecks.io), so a missed backup alerts you.
BACKUP_PING_URL=

# Outgoing email (leave Host empty to log emails instead of sending).
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=
