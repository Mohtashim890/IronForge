{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "JwtSettings": {
    "Issuer": "IronForge.Api",
    "Audience": "IronForge.Client",
    "ExpirationMinutes": 300
  },
  "AgentCredentialSettings": {
    "Issuer": "IronForge.Api",
    "Audience": "IronForge.Mcp",
    "ExpirationMinutes": 60
  },
  "AISettings": {
    "Model": "gpt-5.6-luna"
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": "https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp",
      "Protocol": "HttpProtobuf",
      "TimeoutMilliseconds": 10000,
      "TracesUrlSuffix": "/v1/traces",
      "MetricsUrlSuffix": "/v1/metrics",
      "LogsUrlSuffix": "/v1/logs"
    }
  },
  "Agent": {
    "ConversationContext": {
      "MaximumHistoryMessages": 100,
      "MaximumContextTokens": 16000,
      "ResponseReserveTokens": 2000,
      "SystemPromptReserveTokens": 1500,
      "ToolDefinitionReserveTokens": 1500,
      "CurrentMessageReserveTokens": 1000,
      "ApproximateCharactersPerToken": 4,
      "MaximumToolResultTokens": 2000,
      "ToolResultHeadTokens": 1800,
      "UseConversationSummary": true,
      "AutomaticSummarizationEnabled": true,
      "SummaryTriggerTokens": 12000,
      "SummaryTriggerMessageCount": 30,
      "MinimumMessagesBeforeSummary": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7056",
      "http://localhost:5033",
      "https://localhost:7090",
      "http://localhost:5090"
    ]
  },
  "AllowedHosts": "*",
  "Invitations": {
    "AcceptUrl": "https://localhost:7056/accept-invite",
    "LifetimeDays": 7
  },
  "AppUrls": {
    "WebBaseUrl": "https://localhost:7056",
    "ResetPasswordUrl": "https://localhost:7056/reset-password",
    "ApiBaseUrl": "https://localhost:7226"
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@ironforge.local",
    "FromName": "IronForge"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "BillingJob": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "Seed": {
    "Demo": false
  }
}
