{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AgentCredentialSettings": {
    "Issuer": "IronForge.Api",
    "Audience": "IronForge.Mcp",
    "ExpirationMinutes": 60
  },
  "Agent": {
    "ConversationContext": {
      "MaximumHistoryMessages": 100,
      "MaximumContextTokens": 16000,
      "ResponseReserveTokens": 2000,
      "SystemPromptReserveTokens": 1500,
      "ToolDefinitionReserveTokens": 1500,
      "CurrentMessageReserveTokens": 1000,
      "ApproximateCharactersPerToken": 4,
      "MaximumToolResultTokens": 2000,
      "ToolResultHeadTokens": 1800,
      "UseConversationSummary": true,
      "AutomaticSummarizationEnabled": true,
      "SummaryTriggerTokens": 12000,
      "SummaryTriggerMessageCount": 30,
      "MinimumMessagesBeforeSummary": 10
    }
  },
  "AllowedHosts": "*",
  "AISettings": {
    "ModelProfiles": {
      "standard": {
        "Description": "Default model for general-purpose agents."
      },
      "economy": {
        "MaxOutputTokens": 4000,
        "Description": "Lower cost: capped output. Point it at a cheaper model with AISettings__ModelProfiles__economy__Model."
      }
    }
  },
  "AgentQuotas": {
    "DefaultMonthlyTokenLimit": null
  },
  "Invitations": {
    "AcceptUrl": "https://localhost/accept-invite",
    "LifetimeDays": 7
  }
}
