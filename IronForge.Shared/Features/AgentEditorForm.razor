@using IronForge.Shared.Models.Agents
@using IronForge.Shared.Models.Agents.Manage
@using Microsoft.AspNetCore.Components.Forms
@using IronForge.Shared.Authorization

<EditForm Model="@Model"
          OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    <div class="agent-form">
        @if (Model.IsManaged)
        {
            <div class="agent-form-managed" role="note">
                This agent is managed by a platform template and is updated by the
                platform. You can turn it on or off and choose who may use it. To
                change anything else, detach it from its template first.
            </div>
        }

        <div class="agent-form-field">
            <label for="agent-id">Agent ID</label>

            @if (IsEdit)
            {
                <div class="agent-readonly-id">
                    <code>@Model.AgentId</code>
                </div>
            }
            else
            {
                <InputText id="agent-id"
                           class="form-control"
                           @bind-Value="Model.AgentId" />

                <ValidationMessage For="@(() => Model.AgentId)" />

                <small>
                    The agent ID is the stable identity used by authorization,
                    delegation, and runtime agent execution.
                </small>
            }
        </div>

        <fieldset class="agent-form-plain" disabled="@Model.IsManaged">
        <div class="agent-form-field">
            <label for="agent-name">Name</label>

            <InputText id="agent-name"
                       class="form-control"
                       @bind-Value="Model.Name" />

            <ValidationMessage For="@(() => Model.Name)" />
        </div>

        <div class="agent-form-field">
            <label for="agent-description">Description</label>

            <InputTextArea id="agent-description"
                           class="form-control"
                           @bind-Value="Model.Description"
                           rows="4" />

            <ValidationMessage For="@(() => Model.Description)" />
        </div>

        </fieldset>

        <div class="agent-form-grid">
            <div class="agent-form-field">
                <label for="agent-version">Version</label>

                <InputText id="agent-version"
                           class="form-control"
                           disabled="@Model.IsManaged"
                           @bind-Value="Model.Version" />

                <ValidationMessage For="@(() => Model.Version)" />
            </div>

            <div class="agent-form-field agent-form-active">
                <div class="form-check">
                    <InputCheckbox id="agent-active"
                                   class="form-check-input"
                                   @bind-Value="Model.IsActive" />

                    <label class="form-check-label"
                           for="agent-active">
                        Active
                    </label>
                </div>
            </div>
        </div>

        <fieldset class="agent-form-section" disabled="@Model.IsManaged">
            <legend>Behaviour</legend>

            <div class="agent-form-field">
                <label for="agent-instructions">Instructions (system prompt)</label>

                <InputTextArea id="agent-instructions"
                               class="form-control agent-instructions"
                               @bind-Value="Model.Instructions"
                               rows="12" />

                <div class="agent-form-hint-row">
                    <small>
                        Sent to the model before every conversation. Describe the
                        agent's role, scope, how to use its tools and what it must
                        never do. Not shown to users and not stored in conversations.
                    </small>

                    <small class="@(InstructionsLength > AgentConfigurationLimits.MaximumInstructionsLength ? "text-danger" : null)">
                        @InstructionsLength / @AgentConfigurationLimits.MaximumInstructionsLength
                    </small>
                </div>

                <ValidationMessage For="@(() => Model.Instructions)" />
            </div>

            <div class="agent-form-field">
                <label for="agent-model-profile">Model profile</label>

                <InputSelect id="agent-model-profile"
                             class="form-select"
                             @bind-Value="Model.ModelProfile">
                    @if (ModelProfiles.All(x => x.Name != Model.ModelProfile))
                    {
                        <option value="@Model.ModelProfile">@Model.ModelProfile (not configured)</option>
                    }
                    @foreach (var profile in ModelProfiles)
                    {
                        <option value="@profile.Name">@profile.Name — @profile.Model@(profile.MaxOutputTokens is { } max ? $", max {max:N0} output tokens" : "")</option>
                    }
                </InputSelect>

                <small>
                    @(ModelProfiles.FirstOrDefault(x => x.Name == Model.ModelProfile)?.Description
                        ?? "Platform-defined model configuration. Profiles are set by the platform operator.")
                </small>

                <ValidationMessage For="@(() => Model.ModelProfile)" />
            </div>

            <div class="agent-form-limits">
                <div class="agent-form-field">
                    <label for="agent-max-steps">Maximum steps per request</label>

                    <InputNumber id="agent-max-steps"
                                 class="form-control"
                                 @bind-Value="Model.MaximumIterationsPerRequest"
                                 min="@AgentConfigurationLimits.MinimumIterationsPerRequest"
                                 max="@AgentConfigurationLimits.MaximumIterationsPerRequest" />

                    <small>
                        How many model ↔ tool round trips one message may use
                        (@AgentConfigurationLimits.MinimumIterationsPerRequest–@AgentConfigurationLimits.MaximumIterationsPerRequest).
                        Limits cost and runaway loops.
                    </small>

                    <ValidationMessage For="@(() => Model.MaximumIterationsPerRequest)" />
                </div>

                <div class="agent-form-field">
                    <label for="agent-approval-lifetime">Approval expiry (minutes)</label>

                    <InputNumber id="agent-approval-lifetime"
                                 class="form-control"
                                 @bind-Value="Model.ApprovalLifetimeMinutes"
                                 min="@AgentConfigurationLimits.MinimumApprovalLifetimeMinutes"
                                 max="@AgentConfigurationLimits.MaximumApprovalLifetimeMinutes" />

                    <small>
                        How long a pending approval stays valid before it expires.
                    </small>

                    <ValidationMessage For="@(() => Model.ApprovalLifetimeMinutes)" />
                </div>
            </div>

            <div class="form-check">
                <InputCheckbox id="agent-multiple-tool-calls"
                               class="form-check-input"
                               @bind-Value="Model.AllowMultipleToolCalls" />

                <label class="form-check-label"
                       for="agent-multiple-tool-calls">
                    Allow several tool calls in one model step
                </label>
            </div>
        </fieldset>

        <fieldset class="agent-form-section">
            <legend>Who may use it</legend>

            <div class="agent-form-roles">
                @foreach (var role in TenantRoles.All)
                {
                    <label class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               checked="@Model.AllowedRoles.Contains(role)"
                               @onchange="e => ToggleRole(role, e.Value is true)" />
                        <span class="form-check-label">@role</span>
                    </label>
                }
            </div>

            <small>
                @(Model.AllowedRoles.Count == 0
                    ? "No role selected: every member may chat with this agent."
                    : "Only members with a selected role may chat with this agent.")
            </small>
        </fieldset>

        <div class="agent-form-note">
            Tools are managed separately from this form, and the agent's
            permissions follow from its tools. This prevents a metadata edit
            from accidentally changing the agent's effective capabilities.
        </div>

        <div class="agent-form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="OnCancel"
                    disabled="@IsSubmitting">
                Cancel
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">
                @(IsSubmitting
                    ? (IsEdit ? "Saving..." : "Creating...")
                    : (IsEdit ? "Save Changes" : "Create Agent"))
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public AgentEditorModel Model { get; set; } = null!;

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public IReadOnlyList<AgentModelProfileDto> ModelProfiles { get; set; } = [];

    private int InstructionsLength => Model.Instructions?.Length ?? 0;

    private void ToggleRole(string role, bool selected)
    {
        Model.AllowedRoles.Remove(role);

        if (selected)
        {
            Model.AllowedRoles.Add(role);
        }
    }
}
