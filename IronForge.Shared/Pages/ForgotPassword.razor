@page "/forgot-password"
@layout IronForge.Shared.Components.Layout.AuthLayout

@using IronForge.Shared.Services.Gym
@inject PublicApiClient Api

<PageTitle>Forgot password | IronForge</PageTitle>

<div class="if-auth">
    <div class="if-auth-card">
        <div class="if-auth-brand"><span>⚒</span> IronForge</div>

        <h1>Reset your password</h1>
        <p>Enter the email address of your account. We'll send you a link to choose a new password.</p>

        @if (_sent)
        {
            <div class="if-alert success">
                If an account uses <strong>@_email</strong>, a reset link is on its way. The link works for one hour.
            </div>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="if-alert error">@_error</div>
            }

            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <div class="if-field">
                    <label for="email">Email</label>
                    <input id="email" type="email" autocomplete="email" required @bind="_email" />
                </div>

                <button class="if-btn primary block" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">
                    @(_busy ? "Sending…" : "Send reset link")
                </button>
            </form>
        }

        <p class="if-small" style="margin-top: 18px; text-align: center">
            <a href="/login">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    private string _email = "";
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.ForgotPasswordAsync(_email.Trim());

        _busy = false;

        if (result.Success)
            _sent = true;
        else
            _error = result.ErrorMessage;
    }
}
