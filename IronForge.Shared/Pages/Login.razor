@page "/login"

@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using IronForge.Shared.Models
@using IronForge.Shared.Services
@using IronForge.Shared.Components.Layout

@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ClientAppProfile Profile

<div class="login-page">

    <div class="login-background-decoration decoration-one"></div>
    <div class="login-background-decoration decoration-two"></div>

    <div class="login-container">

        <div class="login-brand">

            <div class="login-brand-mark">
                ⚒
            </div>

            <div class="login-brand-name">
                IronForge
            </div>

            <div class="login-brand-subtitle">
                @Profile.AppName
            </div>

        </div>

        <div class="login-card">

            <div class="login-heading">

                <h1>Welcome back</h1>

                <p>
                    @(Profile.Audience switch
                    {
                        ClientAudience.Member => "Sign in to train, track and pay with your gym.",
                        ClientAudience.Platform => "Sign in to operate the IronForge platform.",
                        _ => "Sign in to manage your gym."
                    })
                </p>

            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error" role="alert">

                    <div class="login-error-icon">
                        !
                    </div>

                    <div>
                        @_errorMessage
                    </div>

                </div>
            }

            @if (_recoveryCodes is not null)
            {
                <div class="login-two-factor">
                    <p><strong>Two-factor sign-in is on.</strong> Save these recovery codes somewhere safe (a password manager or on paper).
                        Each one signs you in once if you lose your phone.</p>
                    <ul class="login-recovery-codes">
                        @foreach (var recoveryCode in _recoveryCodes)
                        {
                            <li>@recoveryCode</li>
                        }
                    </ul>
                    <button type="button" class="login-submit" @onclick="ContinueAsync">I saved them, continue</button>
                </div>
            }
            else if (_challenge is not null)
            {
                <form class="login-two-factor" @onsubmit="VerifyCodeAsync">
                    @if (_challenge.TwoFactorSetupRequired)
                    {
                        <p><strong>Set up two-factor sign-in.</strong> Platform operator accounts need a code from an authenticator app
                            (Google Authenticator, Microsoft Authenticator or similar) as well as the password.</p>

                        @if (_setup is not null)
                        {
                            <ol class="if-small">
                                <li>In the app, add an account and scan this code.</li>
                                <li>Enter the 6-digit code the app shows.</li>
                            </ol>
                            <div class="login-qr">@((MarkupString)QrSvg.Render(_setup.OtpAuthUri))</div>
                            <p class="if-small">Can't scan it? Enter this key: <span class="if-mono">@_setup.ManualKey</span></p>
                        }
                    }
                    else
                    {
                        <p>Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
                    }

                    <div class="login-field">
                        <label for="code">Code</label>
                        <div class="login-input-wrapper">
                            <input id="code"
                                   class="login-input"
                                   @bind="_code"
                                   autocomplete="one-time-code"
                                   inputmode="@(_challenge.TwoFactorSetupRequired ? "numeric" : "text")"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   maxlength="20"
                                   placeholder="123456" />
                        </div>
                    </div>

                    <button type="submit" class="login-submit" disabled="@(_isSubmitting || (_challenge.TwoFactorSetupRequired && _setup is null))">
                        @if (_isSubmitting)
                        {
                            <span class="login-spinner"></span>
                            <span>Checking...</span>
                        }
                        else
                        {
                            <span>@(_challenge.TwoFactorSetupRequired ? "Turn on and sign in" : "Sign in")</span>
                        }
                    </button>

                    <div class="login-links">
                        <a href="" @onclick="BackToPassword" @onclick:preventDefault="true">Back to sign in</a>
                    </div>
                </form>
            }
            else
            {
            <EditForm Model="_model"
                      OnValidSubmit="HandleLoginAsync">

                <DataAnnotationsValidator />

                <div class="login-field">
                <label for="username">Email or username</label>

                <div class="login-input-wrapper">
                    <span class="login-input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M20 21a8 8 0 0 0-16 0" />
                            <circle cx="12" cy="8" r="4" />
                        </svg>
                    </span>

                    <InputText id="username"
                               @bind-Value="_model.Username"
                               class="login-input"
                               autocomplete="username"
                               placeholder="you@example.com" />
                </div>

                <ValidationMessage For="@(() => _model.Username)" />
            </div>

              <div class="login-field">
    <label for="password">Password</label>

    <div class="login-input-wrapper">
        <span class="login-input-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="4" y="10" width="16" height="11" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
        </span>

        <InputText id="password"
                   @bind-Value="_model.Password"
                   type="@(_showPassword ? "text" : "password")"
                   class="login-input password-input"
                   autocomplete="current-password"
                   placeholder="Enter your password" />

        <button type="button"
                class="password-toggle"
                @onclick="() => _showPassword = !_showPassword"
                aria-label="@(_showPassword ? "Hide password" : "Show password")">
            @if (_showPassword)
            {
                <span>Hide</span>
            }
            else
            {
                <span>Show</span>
            }
        </button>
    </div>

    <ValidationMessage For="@(() => _model.Password)" />
</div>

                <button type="submit"
                        class="login-submit"
                        disabled="@_isSubmitting">

                    @if (_isSubmitting)
                    {
                        <span class="login-spinner"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign in</span>

                        <span class="submit-arrow">
                            →
                        </span>
                    }

                </button>

            </EditForm>
            }

            <div class="login-links">
                <a href="/forgot-password">Forgot your password?</a>

                @if (Profile.Audience == ClientAudience.Member)
                {
                    <a href="/join">New member? Join your gym with its code</a>
                }
            </div>

            <div class="login-security-note">

                <span class="security-dot"></span>

                Secure authenticated access

            </div>

        </div>

        <div class="login-footer">
            IronForge · Agentic Gym Platform
        </div>

    </div>

</div>

@code {

    private readonly LoginModel _model = new();

    private bool _isSubmitting;
    private bool _showPassword;
    private string? _errorMessage;

    private string PasswordInputType =>
        _showPassword ? "text" : "password";

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            await ContinueAsync();
        }
    }

    /// <summary>
    /// The platform app works without a gym: operators go straight in.
    /// The gym apps continue with choosing a gym.
    /// </summary>
    private async Task ContinueAsync()
    {
        if (Profile.Audience != ClientAudience.Platform)
        {
            Navigation.NavigateTo("/select-tenant", forceLoad: false);
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (state.User.HasClaim("permission", IronForge.Shared.Authorization.Permissions.PlatformTenantsManage))
        {
            Navigation.NavigateTo(Profile.HomeRoute, forceLoad: false);
            return;
        }

        await AuthService.LogoutAsync();
        _errorMessage = "This account is not a platform operator.";
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting)
            return;

        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var result =
                await AuthService.LoginAsync(
                    _model.Username,
                    _model.Password);

            if (!result.Success)
            {
                _errorMessage =
                    result.ErrorMessage ??
                    "Unable to sign in. Please check your credentials.";

                return;
            }

            if (result.Data!.TwoFactorRequired)
            {
                await StartTwoFactorAsync(result.Data);
                return;
            }

            await ContinueAsync();

            return;
        }
        catch (Exception)
        {
            _errorMessage =
                "An unexpected error occurred while signing in.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Second step: the password was right, a code from the authenticator app is needed.
    private LoginResponse? _challenge;
    private TwoFactorSetupDto? _setup;
    private List<string>? _recoveryCodes;
    private string _code = "";

    private async Task StartTwoFactorAsync(LoginResponse challenge)
    {
        _challenge = challenge;
        _code = "";
        _model.Password = "";

        if (!challenge.TwoFactorSetupRequired)
            return;

        var setup = await AuthService.BeginTwoFactorSetupAsync(challenge.TwoFactorToken!);

        if (setup.Success)
        {
            _setup = setup.Data;
        }
        else
        {
            _errorMessage = setup.ErrorMessage;
        }
    }

    private async Task VerifyCodeAsync()
    {
        if (_isSubmitting || _challenge is null || string.IsNullOrWhiteSpace(_code))
            return;

        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var result = await AuthService.CompleteTwoFactorAsync(_challenge.TwoFactorToken!, _code);

            if (!result.Success)
            {
                _errorMessage = result.ErrorMessage;
                _code = "";

                // The challenge expired or the password was reset meanwhile: start over.
                if (result.StatusCode == 403)
                    BackToPassword();

                return;
            }

            if (result.Data!.RecoveryCodes is { Count: > 0 } codes)
            {
                _recoveryCodes = codes;
                return;
            }

            await ContinueAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void BackToPassword()
    {
        _challenge = null;
        _setup = null;
        _code = "";
    }

    private sealed class LoginModel
    {
        [Required(
            ErrorMessage = "Username is required.")]
        public string Username { get; set; } = "";

        [Required(
            ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}