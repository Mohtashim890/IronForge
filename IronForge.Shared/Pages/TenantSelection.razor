@page "/select-tenant"

@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using IronForge.Shared.Models
@using IronForge.Shared.Services
@using IronForge.Shared.Components.Layout

@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ClientAppProfile Profile

<PageTitle>Choose your gym | IronForge</PageTitle>

<div class="tenant-selection-page">
    <div class="tenant-selection-brand">
        <div class="tenant-selection-logo">
            ⚒
        </div>

        <div>
            <div class="tenant-selection-brand-name">
                IronForge
            </div>

            <div class="tenant-selection-brand-subtitle">
                @Profile.AppName
            </div>
        </div>
    </div>

    <div class="tenant-selection-card">

        <div class="tenant-selection-header">
            <span class="tenant-selection-eyebrow">
                GYM
            </span>

            <h1>Choose your gym</h1>

            <p>
                Each gym's members, billing and agents are kept separate.
            </p>
        </div>

        @if (isLoading)
        {
            <div class="tenant-loading">
                <div class="tenant-spinner"></div>

                <span>
                    Loading your gyms...
                </span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="tenant-error" role="alert">
                <strong>Unable to continue</strong>

                <span>
                    @errorMessage
                </span>

                <button type="button"
                        @onclick="LoadTenantsAsync">
                    Try again
                </button>
            </div>
        }
        else if (tenants.Count == 0)
        {
            <div class="tenant-empty">
                <div class="tenant-empty-icon">
                    !
                </div>

                <h2>No gym available</h2>

                <p>
                    @(hasOtherRoles
                        ? Profile.WrongAppMessage
                        : "Your account is not part of an active gym. Ask your gym for an invitation, or join with its code.")
                </p>

                <button type="button" class="if-btn" @onclick="SignOutAsync">Sign out</button>
            </div>
        }
        else
        {
            <div class="tenant-list">

                @foreach (var tenant in tenants)
                {
                    <button type="button"
                            class="tenant-option"
                            disabled="@isSelecting"
                            @onclick="() => SelectTenantAsync(tenant)">

                        <span class="tenant-option-icon">
                            @GetTenantInitial(tenant)
                        </span>

                        <span class="tenant-option-content">
                            <strong>
                                @tenant.TenantName
                            </strong>

                            <small>
                                @tenant.Role
                                @if (!string.IsNullOrWhiteSpace(tenant.Slug))
                                {
                                    <span> · @tenant.Slug</span>
                                }
                            </small>
                        </span>

                        <span class="tenant-option-arrow">
                            →
                        </span>
                    </button>
                }

            </div>
        }

        @if (isSelecting)
        {
            <div class="tenant-selection-status">
                Opening your gym...
            </div>
        }


    </div>

    <div class="tenant-selection-footer">
        IronForge · Agentic Gym Platform
    </div>

</div>

@code {

    private List<TenantMembership> tenants = new();

    // The account has gyms, but none with a role this app serves.
    private bool hasOtherRoles;

    private bool isLoading = true;
    private bool isSelecting;

    private string? errorMessage;

    // OnInitializedAsync (unlike OnAfterRenderAsync) re-renders the component
    // when it completes, so the isLoading = false state is displayed.
    // The app runs without prerendering, so JS interop (token storage) works here.
    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result =
                await AuthService.GetMyTenantsAsync();

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(
                        result.ErrorMessage)
                        ? "Unable to load your gyms."
                        : result.ErrorMessage;

                tenants = new();

                return;
            }

            var all = result.Data ?? new();

            // Staff use the web dashboard, members the mobile app.
            tenants = all
                .Where(x => Profile.AcceptsRole(x.Role))
                .ToList();

            hasOtherRoles = tenants.Count == 0 && all.Count > 0;

            // One gym: select it automatically.
            if (tenants.Count == 1)
            {
                await SelectTenantAsync(
                    tenants[0]);

                return;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectTenantAsync(
        TenantMembership tenant)
    {
        if (isSelecting)
            return;

        isSelecting = true;
        errorMessage = null;

        try
        {
            var result =
                await AuthService.SelectTenantAsync(
                    tenant.TenantId);

            if (!result.Success)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(
                        result.ErrorMessage)
                        ? "Unable to open this gym."
                        : result.ErrorMessage;

                return;
            }

            Navigation.NavigateTo(
                Profile.HomeRoute,
                forceLoad: false);
        }
        finally
        {
            isSelecting = false;
        }
    }

    private async Task SignOutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    private static string GetTenantInitial(
        TenantMembership tenant)
    {
        if (string.IsNullOrWhiteSpace(
            tenant.TenantName))
        {
            return "?";
        }

        return tenant.TenantName
            .Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }
}