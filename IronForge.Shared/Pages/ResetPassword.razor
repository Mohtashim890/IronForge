@page "/reset-password"
@layout IronForge.Shared.Components.Layout.AuthLayout

@using IronForge.Shared.Services.Gym
@inject PublicApiClient Api

<PageTitle>Choose a new password | IronForge</PageTitle>

<div class="if-auth">
    <div class="if-auth-card">
        <div class="if-auth-brand"><span>⚒</span> IronForge</div>

        <h1>Choose a new password</h1>
        <p>Use at least 8 characters. You'll be signed out on all your devices.</p>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="if-alert error">This link is incomplete. Open the link from the email again.</div>
        }
        else if (_done)
        {
            <div class="if-alert success">Your password was changed. You can sign in now.</div>
            <a class="if-btn primary block" href="/login">Sign in</a>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="if-alert error">@_error</div>
            }

            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <div class="if-field">
                    <label for="password">New password</label>
                    <PasswordInput Id="password" Autocomplete="new-password" @bind-Value="_password" />
                </div>

                <div class="if-field">
                    <label for="confirm">Repeat the new password</label>
                    <PasswordInput Id="confirm" Autocomplete="new-password" @bind-Value="_confirm" />
                </div>

                <button class="if-btn primary block" type="submit" disabled="@_busy">
                    @(_busy ? "Saving…" : "Save new password")
                </button>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = "";
    private string _confirm = "";
    private bool _busy;
    private bool _done;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_password.Length < 8)
        {
            _error = "Use at least 8 characters.";
            return;
        }

        if (_password != _confirm)
        {
            _error = "The two passwords do not match.";
            return;
        }

        _busy = true;
        _error = null;

        var result = await Api.ResetPasswordAsync(Token!, _password);

        _busy = false;

        if (result.Success)
            _done = true;
        else
            _error = result.ErrorMessage;
    }
}
