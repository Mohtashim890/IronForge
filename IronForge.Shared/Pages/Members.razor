@page "/members"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(
    Policy = IronForge.Shared.Authorization.Permissions.MembersRead)]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using IronForge.Shared.Authorization
@using IronForge.Shared.Components.Dialogs
@using IronForge.Shared.Components.Management
@using IronForge.Shared.Components.UI
@using IronForge.Shared.Models.Tenants

@inject ITenantMembersService MembersService
@inject IJSRuntime JS

<PageTitle>Members</PageTitle>

<div class="members-page">
    <PageHeader Title="Members"
                Subtitle="People who can access this workspace and what they can do.">
        <Actions>
            @if (canManage)
            {
                <button type="button"
                        class="btn btn-primary"
                        @onclick="OpenInvite">
                    + Invite member
                </button>
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger members-alert" role="alert">
            @actionError
        </div>
    }

    @if (showInvite)
    {
        <section class="members-panel" aria-label="Invite member">
            <div class="members-panel-header">
                <div>
                    <h2>Invite a member</h2>
                    <p>
                        Creates a single-use link. Send it to the person yourself;
                        it is shown only once and expires after a few days.
                    </p>
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="CloseInvite"
                        disabled="@isInviting">
                    Close
                </button>
            </div>

            @if (createdLink is null)
            {
                <EditForm Model="inviteModel" OnValidSubmit="InviteAsync">
                    <DataAnnotationsValidator />

                    <div class="members-form-grid">
                        <div>
                            <label class="form-label" for="invite-email">Email</label>
                            <InputText id="invite-email"
                                       class="form-control"
                                       @bind-Value="inviteModel.Email"
                                       placeholder="name@company.com" />
                            <ValidationMessage For="@(() => inviteModel.Email)" />
                        </div>

                        <div>
                            <label class="form-label" for="invite-role">Role</label>
                            <InputSelect id="invite-role"
                                         class="form-select"
                                         @bind-Value="inviteModel.Role">
                                @foreach (var role in TenantRoles.All)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <p class="members-role-hint">@RoleDescription(inviteModel.Role)</p>

                    @if (!string.IsNullOrWhiteSpace(inviteError))
                    {
                        <div class="alert alert-danger" role="alert">@inviteError</div>
                    }

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isInviting">
                        @(isInviting ? "Creating..." : "Create invitation link")
                    </button>
                </EditForm>
            }
            else
            {
                <InvitationLinkBox Link="@createdLink"
                                   OnCopy="() => CopyAsync(createdLink.AcceptUrl)"
                                   Copied="@linkCopied" />

                <button type="button"
                        class="btn btn-outline-primary mt-3"
                        @onclick="OpenInvite">
                    Invite someone else
                </button>
            }
        </section>
    }

    <ResourceList TItem="TenantMemberDto"
                  Items="@members"
                  IsLoading="@isLoading"
                  ErrorMessage="@loadError"
                  EmptyTitle="No members"
                  EmptyMessage="Invite people to give them access to this workspace."
                  OnRetry="LoadAsync">

        <ToolbarContent>
            <div class="members-summary">
                <span>@members.Count(x => x.IsActive) active</span>
                @if (members.Any(x => !x.IsActive))
                {
                    <span>@members.Count(x => !x.IsActive) deactivated</span>
                }
            </div>
        </ToolbarContent>

        <RowTemplate Context="member">
            <div class="member-row @(member.IsActive ? "" : "member-row-inactive")">
                <div class="member-main">
                    <div class="member-title">
                        <strong>@member.Username</strong>
                        @if (member.IsCurrentUser)
                        {
                            <span class="member-you">You</span>
                        }
                        <StatusBadge Text="@(member.IsActive ? "Active" : "Deactivated")" />
                    </div>
                    <span class="member-email">@member.Email</span>
                </div>

                <div class="member-role">
                    @if (canManage && !member.IsCurrentUser)
                    {
                        <select class="form-select form-select-sm"
                                aria-label="Role of @member.Username"
                                value="@member.Role"
                                disabled="@(busyUserId == member.UserId)"
                                @onchange="e => ChangeRoleAsync(member, e.Value?.ToString())">
                            @foreach (var role in TenantRoles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    }
                    else
                    {
                        <strong>@member.Role</strong>
                    }
                    <span class="member-joined">Joined @member.JoinedAtUtc.ToLocalTime().ToString("d")</span>
                </div>

                <div class="member-actions">
                    @if (canManage && !member.IsCurrentUser)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                disabled="@(busyUserId == member.UserId)"
                                @onclick="() => ToggleStatusAsync(member)">
                            @(member.IsActive ? "Deactivate" : "Activate")
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                disabled="@(busyUserId == member.UserId)"
                                @onclick="() => removeCandidate = member">
                            Remove
                        </button>
                    }
                </div>
            </div>
        </RowTemplate>
    </ResourceList>

    @if (canManage && invitations.Count > 0)
    {
        <section class="members-invitations" aria-label="Open invitations">
            <h2>Open invitations</h2>

            @foreach (var invitation in invitations)
            {
                <div class="invitation-row">
                    <div>
                        <strong>@invitation.Email</strong>
                        <span class="invitation-meta">
                            @invitation.Role ·
                            @(invitation.IsExpired
                                ? "expired"
                                : $"expires {invitation.ExpiresAtUtc.ToLocalTime():g}")
                        </span>
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="() => RevokeAsync(invitation)">
                        Revoke
                    </button>
                </div>
            }
        </section>
    }

    <ConfirmDialog Visible="@(removeCandidate is not null)"
                   Title="@($"Remove {removeCandidate?.Username}?")"
                   Message="They lose access to this workspace immediately at their next sign-in or token refresh. Their account is kept, so they can be invited again."
                   ConfirmText="Remove member"
                   BusyText="Removing..."
                   Busy="@isRemoving"
                   OnConfirm="RemoveAsync"
                   OnCancel="() => removeCandidate = null" />
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private List<TenantMemberDto> members = [];
    private List<TenantInvitationDto> invitations = [];
    private bool isLoading;
    private string? loadError;
    private string? actionError;
    private bool canManage;
    private int? busyUserId;

    private bool showInvite;
    private CreateTenantInvitationRequest inviteModel = new();
    private bool isInviting;
    private string? inviteError;
    private TenantInvitationLinkDto? createdLink;
    private bool linkCopied;

    private TenantMemberDto? removeCandidate;
    private bool isRemoving;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;

            canManage = user.HasClaim(
                "permission",
                Permissions.MembersManage);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var result = await MembersService.GetMembersAsync();

            if (!result.Success)
            {
                loadError = result.ErrorMessage;
                return;
            }

            members = result.Data ?? [];

            if (canManage)
            {
                var invitationResult = await MembersService.GetInvitationsAsync();

                invitations = invitationResult.Success
                    ? invitationResult.Data ?? []
                    : [];
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenInvite()
    {
        inviteModel = new CreateTenantInvitationRequest { Role = TenantRoles.Member };
        inviteError = null;
        createdLink = null;
        linkCopied = false;
        showInvite = true;
    }

    private void CloseInvite()
    {
        showInvite = false;
        createdLink = null;
    }

    private async Task InviteAsync()
    {
        isInviting = true;
        inviteError = null;

        try
        {
            var result = await MembersService.InviteAsync(inviteModel);

            if (!result.Success)
            {
                inviteError = result.ErrorMessage;
                return;
            }

            createdLink = result.Data;
            await LoadAsync();
        }
        finally
        {
            isInviting = false;
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            linkCopied = true;
        }
        catch (JSException)
        {
            // Clipboard not available: the link stays visible for manual copying.
        }
    }

    private async Task ChangeRoleAsync(TenantMemberDto member, string? role)
    {
        if (string.IsNullOrWhiteSpace(role) || role == member.Role)
            return;

        await RunMemberActionAsync(
            member,
            () => MembersService.UpdateRoleAsync(member.UserId, role));
    }

    private Task ToggleStatusAsync(TenantMemberDto member)
    {
        return RunMemberActionAsync(
            member,
            () => MembersService.UpdateStatusAsync(member.UserId, !member.IsActive));
    }

    private async Task RunMemberActionAsync(
        TenantMemberDto member,
        Func<Task<IronForge.Shared.Models.ServiceResult<TenantMemberDto>>> action)
    {
        busyUserId = member.UserId;
        actionError = null;

        try
        {
            var result = await action();

            if (!result.Success)
            {
                actionError = result.ErrorMessage;
            }

            // Reload either way: a rejected role change must snap back in the select.
            await LoadAsync();
        }
        finally
        {
            busyUserId = null;
        }
    }

    private async Task RemoveAsync()
    {
        if (removeCandidate is null)
            return;

        isRemoving = true;
        actionError = null;

        try
        {
            var result = await MembersService.RemoveAsync(removeCandidate.UserId);

            if (!result.Success)
            {
                actionError = result.ErrorMessage;
            }

            removeCandidate = null;
            await LoadAsync();
        }
        finally
        {
            isRemoving = false;
        }
    }

    private async Task RevokeAsync(TenantInvitationDto invitation)
    {
        actionError = null;

        var result = await MembersService.RevokeInvitationAsync(invitation.InvitationId);

        if (!result.Success)
        {
            actionError = result.ErrorMessage;
        }

        await LoadAsync();
    }

    private static string RoleDescription(string role) => role switch
    {
        TenantRoles.Admin => "Admin: full access, including agents, MCP clients and members.",
        TenantRoles.Viewer => "Viewer: read-only access to products and activity.",
        _ => "Member: works with products and agents; cannot manage the workspace."
    };
}
