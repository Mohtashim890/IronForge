@page "/agents"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(
    Policy = IronForge.Shared.Authorization.Permissions.AgentsRead)]

@using IronForge.Shared.Authorization
@using IronForge.Shared.Features
@using IronForge.Shared.Models.Agents.Manage
@using IronForge.Shared.Services

@inject IAgentManagementService AgentManagementService
@inject NavigationManager Navigation;

<PageTitle>Agents</PageTitle>

<div class="agent-management-page">
    <div class="agent-management-header">
        <div>
            <h1>Agents</h1>
            <p>
                Manage registered agent identities, capabilities, and lifecycle state.
            </p>
        </div>

        <AuthorizeView Policy="@Permissions.AgentsCreate">
            <Authorized>
                <button type="button"
                        class="btn btn-primary"
                        @onclick="BeginCreate">
                    + New Agent
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (usage is not null)
    {
        <section class="agent-usage-panel" aria-label="Agent usage this month">
            <div class="agent-usage-heading">
                <div>
                    <strong>Agent usage this month</strong>
                    <span class="agent-list-muted">
                        Resets @usage.PeriodEndUtc.ToLocalTime().ToString("d MMM yyyy")
                    </span>
                </div>

                <div class="agent-usage-numbers @(usage.IsExceeded ? "exceeded" : null)">
                    <strong>@usage.TokensUsed.ToString("N0")</strong>
                    @if (usage.MonthlyTokenLimit is { } limit)
                    {
                        <span>of @limit.ToString("N0") tokens</span>
                    }
                    else
                    {
                        <span>tokens (no limit)</span>
                    }
                </div>
            </div>

            @if (usage.MonthlyTokenLimit is { } quota && quota > 0)
            {
                <div class="agent-usage-bar"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="@quota"
                     aria-valuenow="@usage.TokensUsed">
                    <div style="width: @UsagePercent(quota).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>
            }

            @if (usage.IsExceeded)
            {
                <div class="agent-usage-warning">
                    The monthly allowance is used up. Agents will refuse new requests
                    until it resets.
                </div>
            }
        </section>
    }

    @if (showEditor)
    {
        <section class="agent-editor-panel" aria-label="Agent editor">
            <div class="agent-editor-heading">
                <div>
                    <h2>@(editingAgentId is null ? "Create Agent" : "Edit Agent")</h2>
                    <p>
                        @(editingAgentId is null
                            ? "Register a persistent agent identity."
                            : "Update the agent's metadata, behaviour and lifecycle state.")
                    </p>
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="CloseEditor"
                        disabled="@isSaving">
                    Close
                </button>
            </div>

            <AgentEditorForm Model="@editorModel"
                             ModelProfiles="@modelProfiles"
                             IsEdit="@(editingAgentId is not null)"
                             IsSubmitting="@isSaving"
                             ErrorMessage="@editorError"
                             OnValidSubmit="SaveEditorAsync"
                             OnCancel="CloseEditor" />
        </section>
    }

    <section class="agent-list-panel">
        <div class="agent-list-toolbar">
            <div>
                <strong>@agents.Count agent@(agents.Count == 1 ? "" : "s")</strong>

                @if (agents.Count > 0)
                {
                    <span class="agent-list-muted">
                        @activeAgentCount active
                    </span>
                }
            </div>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="LoadAgentsAsync"
                    disabled="@isLoading">
                @(isLoading ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (isLoading && agents.Count == 0)
        {
            <div class="agent-state">
                Loading agents...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <div>@errorMessage</div>
                <button type="button"
                        class="btn btn-sm btn-outline-danger mt-2"
                        @onclick="LoadAgentsAsync">
                    Retry
                </button>
            </div>
        }
        else if (agents.Count == 0)
        {
            <div class="agent-empty-state">
                <h2>No agents registered</h2>
                <p>Register an agent identity to begin configuring agent capabilities.</p>

                <AuthorizeView Policy="@Permissions.AgentsCreate">
                    <Authorized>
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="BeginCreate">
                            Register Agent
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <div class="agent-list">
                @foreach (var agent in agents)
                {
                    <article class="agent-row">
                        <div class="agent-main">
                            <div class="agent-title-line">
                                <strong>@agent.Name</strong>

                                <span class="agent-status @(agent.IsActive ? "active" : "inactive")">
                                    @(agent.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>

                            <code class="agent-id">@agent.AgentId</code>

                            @if (!string.IsNullOrWhiteSpace(agent.Description))
                            {
                                <p class="agent-description">@agent.Description</p>
                            }
                        </div>

                        <div class="agent-metadata">
                            <div>
                                <span>Version</span>
                                <strong>@agent.Version</strong>
                            </div>

                            <div>
                                <span>Permissions</span>
                                <strong>@agent.Permissions.Count</strong>
                            </div>

                            <div>
                                <span>Tools</span>
                                <strong>@agent.Tools.Count</strong>
                            </div>

                            <div>
                                <span>Model</span>
                                <strong>@agent.ModelProfile</strong>
                            </div>

                            <div>
                                <span>Tokens (month)</span>
                                <strong>@TokensFor(agent.AgentId).ToString("N0")</strong>
                            </div>

                            <div>
                                <span>Updated</span>
                                <strong>@agent.UpdatedAtUtc.ToLocalTime().ToString("g")</strong>
                            </div>
                        </div>

                        <div class="agent-actions">
                            <AuthorizeView Policy="@Permissions.AgentsPermissionsManage">
                                <Authorized>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => BeginPermissions(agent)">
                                        Permissions
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => BeginToolsAsync(agent)">
                                        Tools
                                    </button>
                                </Authorized>
                            </AuthorizeView>

                            <AuthorizeView Policy="@Permissions.AgentsUpdate">
                                <Authorized>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @onclick="() => BeginEdit(agent)">
                                        Edit
                                    </button>
                                </Authorized>
                            </AuthorizeView>

                            <AuthorizeView Policy="@Permissions.AgentsDelete">
                                <Authorized>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RequestDelete(agent)">
                                        Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="@Permissions.AgentsMcpClientsManage">
                                <Authorized>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ManageMcpAccess(agent)">
                                        MCP Access
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (permissionsAgent is not null)
    {
        <section class="agent-editor-panel" aria-label="Agent permissions editor">
            <div class="agent-editor-heading">
                <div>
                    <h2>Permissions — @permissionsAgent.Name</h2>
                    <p>
                        <code>@permissionsAgent.AgentId</code>
                    </p>
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="ClosePermissions"
                        disabled="@isSavingPermissions">
                    Close
                </button>
            </div>

            <AgentPermissionsEditor
                Agent="@permissionsAgent"
                IsSubmitting="@isSavingPermissions"
                ErrorMessage="@permissionsError"
                OnSave="SavePermissionsAsync"
                OnCancel="ClosePermissions" />
        </section>
    }

    @if (toolsAgent is not null)
    {
        <section class="agent-editor-panel" aria-label="Agent tools editor">
            <div class="agent-editor-heading">
                <div>
                    <h2>Tools — @toolsAgent.Name</h2>
                    <p>
                        <code>@toolsAgent.AgentId</code>
                    </p>
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="CloseTools"
                        disabled="@isSavingTools">
                    Close
                </button>
            </div>

            @if (toolCatalogue is null)
            {
                <div class="agent-state">
                    Loading tool catalogue...
                </div>
            }
            else
            {
                <AgentToolsEditor
                    Agent="@toolsAgent"
                    Catalogue="@toolCatalogue"
                    IsSubmitting="@isSavingTools"
                    ErrorMessage="@toolsError"
                    OnSave="SaveToolsAsync"
                    OnCancel="CloseTools" />
            }
        </section>
    }

    @if (deleteCandidate is not null)
    {
        <div class="agent-confirm-backdrop"
             role="presentation"
             @onclick="CloseDeleteConfirmation">
            <div class="agent-confirm-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="agent-delete-title"
                 @onclick:stopPropagation="true">

                <div class="agent-confirm-icon">!</div>

                <h2 id="agent-delete-title">
                    Delete @deleteCandidate.Name?
                </h2>

                <p>
                    This permanently removes the registered agent identity
                    from the current tenant. Existing agent-related data may
                    have dependent relationships, so the API remains
                    authoritative for whether deletion is permitted.
                </p>

                <div class="agent-confirm-details">
                    <span>Agent ID</span>
                    <code>@deleteCandidate.AgentId</code>

                    <span>Permissions</span>
                    <strong>@deleteCandidate.Permissions.Count</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(deleteError))
                {
                    <div class="alert alert-danger" role="alert">
                        @deleteError
                    </div>
                }

                <div class="agent-confirm-actions">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseDeleteConfirmation"
                            disabled="@isDeleting">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="DeleteAsync"
                            disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Delete Agent")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AgentDto> agents = [];

    private bool isLoading;
    private string? errorMessage;

    private bool showEditor;
    private string? editingAgentId;
    private AgentEditorModel editorModel = new();
    private bool isSaving;
    private string? editorError;

    private AgentDto? permissionsAgent;
    private bool isSavingPermissions;
    private string? permissionsError;

    private List<AgentModelProfileDto> modelProfiles = [];
    private AgentUsageSummaryDto? usage;

    private AgentDto? toolsAgent;
    private List<AgentToolCatalogItemDto>? toolCatalogue;
    private bool isSavingTools;
    private string? toolsError;

    private AgentDto? deleteCandidate;
    private bool isDeleting;
    private string? deleteError;

    private int activeAgentCount =>
        agents.Count(x => x.IsActive);

    protected override async Task OnInitializedAsync()
    {
        await LoadAgentsAsync();
        await LoadModelProfilesAsync();
    }

    private async Task LoadModelProfilesAsync()
    {
        // Non-fatal: the editor still works with the agent's current profile.
        var result = await AgentManagementService.GetModelProfilesAsync();

        if (result.Success)
        {
            modelProfiles = result.Data ?? [];
        }
    }

    private async Task LoadUsageAsync()
    {
        // Non-fatal: the agent list is still useful without usage figures.
        var result = await AgentManagementService.GetUsageAsync();
        usage = result.Success ? result.Data : null;
    }

    private long TokensFor(string agentId) =>
        usage?.Agents.FirstOrDefault(x => x.AgentId == agentId)?.TotalTokens ?? 0;

    private double UsagePercent(long limit) =>
        Math.Min(100, Math.Round(usage!.TokensUsed * 100d / limit, 1));

    private async Task LoadAgentsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result =
                await AgentManagementService.GetAgentsAsync();

            if (!result.Success)
            {
                errorMessage =
                    result.ErrorMessage ??
                    "Unable to load agents.";

                return;
            }

            agents = result.Data ?? [];

            await LoadUsageAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        editingAgentId = null;
        editorModel = new AgentEditorModel();
        editorError = null;
        showEditor = true;
    }

    private void BeginEdit(AgentDto agent)
    {
        editingAgentId = agent.AgentId;
        editorModel = AgentEditorModel.From(agent);
        editorError = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        if (isSaving)
            return;

        showEditor = false;
        editingAgentId = null;
        editorError = null;
    }

    private async Task SaveEditorAsync()
    {
        if (isSaving)
            return;

        isSaving = true;
        editorError = null;

        try
        {
            if (editingAgentId is null)
            {
                var result =
                    await AgentManagementService.CreateAgentAsync(
                        editorModel.ToCreateRequest());

                if (!result.Success)
                {
                    editorError =
                        result.ErrorMessage ??
                        "Unable to create the agent.";

                    return;
                }
            }
            else
            {
                var result =
                    await AgentManagementService.UpdateAgentAsync(
                        editingAgentId,
                        editorModel.ToUpdateRequest());

                if (!result.Success)
                {
                    editorError =
                        result.ErrorMessage ??
                        "Unable to update the agent.";

                    return;
                }
            }

            showEditor = false;
            editingAgentId = null;

            await LoadAgentsAsync();
        }
        catch (Exception ex)
        {
            editorError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginPermissions(AgentDto agent)
    {
        permissionsAgent = CloneAgent(agent);
        permissionsError = null;
    }

    private void ClosePermissions()
    {
        if (isSavingPermissions)
            return;

        permissionsAgent = null;
        permissionsError = null;
    }

    private async Task SavePermissionsAsync(
        IReadOnlyCollection<string> permissions)
    {
        if (permissionsAgent is null || isSavingPermissions)
            return;

        isSavingPermissions = true;
        permissionsError = null;

        try
        {
            var result =
                await AgentManagementService.UpdatePermissionsAsync(
                    permissionsAgent.AgentId,
                    new UpdateAgentPermissionsRequest
                    {
                        Permissions = permissions.ToList()
                    });

            if (!result.Success)
            {
                permissionsError =
                    result.ErrorMessage ??
                    "Unable to update agent permissions.";

                return;
            }

            permissionsAgent = null;
            await LoadAgentsAsync();
        }
        catch (Exception ex)
        {
            permissionsError = ex.Message;
        }
        finally
        {
            isSavingPermissions = false;
        }
    }

    private async Task BeginToolsAsync(AgentDto agent)
    {
        toolsAgent = CloneAgent(agent);
        toolsError = null;

        if (toolCatalogue is not null)
            return;

        try
        {
            var result =
                await AgentManagementService.GetToolCatalogAsync();

            if (!result.Success)
            {
                toolsError =
                    result.ErrorMessage ??
                    "Unable to load the tool catalogue.";

                toolCatalogue = [];
                return;
            }

            toolCatalogue = result.Data ?? [];
        }
        catch (Exception ex)
        {
            toolsError = ex.Message;
            toolCatalogue = [];
        }
    }

    private void CloseTools()
    {
        if (isSavingTools)
            return;

        toolsAgent = null;
        toolsError = null;

        // Reload next time, so a failed load can be retried.
        if (toolCatalogue is { Count: 0 })
            toolCatalogue = null;
    }

    private async Task SaveToolsAsync(
        IReadOnlyList<AgentToolBindingDto> tools)
    {
        if (toolsAgent is null || isSavingTools)
            return;

        isSavingTools = true;
        toolsError = null;

        try
        {
            var result =
                await AgentManagementService.UpdateToolsAsync(
                    toolsAgent.AgentId,
                    new UpdateAgentToolsRequest
                    {
                        Tools = tools.ToList()
                    });

            if (!result.Success)
            {
                toolsError =
                    result.ErrorMessage ??
                    "Unable to update agent tools.";

                return;
            }

            toolsAgent = null;
            await LoadAgentsAsync();
        }
        catch (Exception ex)
        {
            toolsError = ex.Message;
        }
        finally
        {
            isSavingTools = false;
        }
    }

    private void RequestDelete(AgentDto agent)
    {
        deleteCandidate = agent;
        deleteError = null;
    }

    private void CloseDeleteConfirmation()
    {
        if (isDeleting)
            return;

        deleteCandidate = null;
        deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (deleteCandidate is null || isDeleting)
            return;

        isDeleting = true;
        deleteError = null;

        try
        {
            var result =
                await AgentManagementService.DeleteAgentAsync(
                    deleteCandidate.AgentId);

            if (!result.Success)
            {
                deleteError =
                    result.ErrorMessage ??
                    "Unable to delete the agent.";

                return;
            }

            deleteCandidate = null;
            await LoadAgentsAsync();
        }
        catch (Exception ex)
        {
            deleteError = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ManageMcpAccess(AgentDto agent)
    {
        Navigation.NavigateTo(
            $"/agents/{Uri.EscapeDataString(agent.AgentId)}/mcp-clients");
    }

    private static AgentDto CloneAgent(AgentDto source) =>
        new()
        {
            Id = source.Id,
            AgentId = source.AgentId,
            Name = source.Name,
            Description = source.Description,
            Version = source.Version,
            IsActive = source.IsActive,
            CreatedAtUtc = source.CreatedAtUtc,
            UpdatedAtUtc = source.UpdatedAtUtc,
            Permissions = [.. source.Permissions],
            Instructions = source.Instructions,
            MaximumIterationsPerRequest = source.MaximumIterationsPerRequest,
            AllowMultipleToolCalls = source.AllowMultipleToolCalls,
            ApprovalLifetimeMinutes = source.ApprovalLifetimeMinutes,
            ModelProfile = source.ModelProfile,
            Tools = source.Tools
                .Select(x => new AgentToolBindingDto
                {
                    ToolName = x.ToolName,
                    RequiresApproval = x.RequiresApproval,
                    RiskLevel = x.RiskLevel,
                    MaximumAmount = x.MaximumAmount
                })
                .ToList()
        };
}
