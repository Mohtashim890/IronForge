<div class="ui-state ui-error-state">

    <div class="ui-error-icon"
         aria-hidden="true">
        !
    </div>

    <h3>
        @Title
    </h3>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>
            @Message
        </p>
    }

    @if (ShowRetry)
    {
        <button type="button"
                class="btn btn-primary"
                @onclick="Retry">

            Try Again

        </button>
    }

</div>

@code
{
    [Parameter]
    public string Title { get; set; } = "Something went wrong.";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool ShowRetry { get; set; } = true;

    [Parameter]
    public EventCallback Retry { get; set; }
}