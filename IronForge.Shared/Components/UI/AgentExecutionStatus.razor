@if (Visible)
{
    <div class="agent-execution-status @CssClass"
         role="status"
         aria-live="polite">

        <span class="agent-execution-indicator"
              aria-hidden="true"></span>

        <div class="agent-execution-content">

            <strong>@Title</strong>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <span>@Message</span>
            }

        </div>

    </div>
}

@code {

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Working";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "";
}