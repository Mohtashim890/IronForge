@implements IAsyncDisposable
@inject IJSRuntime JS

@* Camera QR reader (qr-scanner.js). A USB or Bluetooth scanner that types
   like a keyboard needs no camera: the host page offers a text box for it. *@

<div class="if-scanner @(_running ? "running" : "")">
    <video @ref="_video" class="if-scanner-video" aria-label="Camera preview"></video>

    @if (!_running)
    {
        <div class="if-scanner-idle">
            <span class="if-scanner-icon" aria-hidden="true">⌗</span>
            <button type="button" class="if-btn primary" disabled="@_starting" @onclick="StartAsync">
                @(_starting ? "Starting camera…" : StartLabel)
            </button>
        </div>
    }
    else
    {
        <button type="button" class="if-btn sm if-scanner-stop" @onclick="StopAsync">Stop camera</button>
    }
</div>

@if (_error is not null)
{
    <div class="if-alert warning" style="margin-top: 8px">@_error</div>
}

@code {
    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QrScanner>? _self;
    private bool _running;
    private bool _starting;
    private string? _error;

    /// <summary>Called with the text of each QR code read (the same code at most every 5 s).</summary>
    [Parameter] public EventCallback<string> OnCode { get; set; }

    /// <summary>Start the camera when the component appears (a kiosk); otherwise on a button press.</summary>
    [Parameter] public bool AutoStart { get; set; }

    [Parameter] public string StartLabel { get; set; } = "Scan with camera";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoStart)
        {
            await StartAsync();
        }
    }

    public async Task StartAsync()
    {
        if (_running || _starting)
            return;

        _starting = true;
        _error = null;
        StateHasChanged();

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/IronForge.Shared/js/qr-scanner.js");
            _self ??= DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("start", _video, _self);
            _running = true;
        }
        catch (JSException ex)
        {
            _error = ex.Message.Contains("Permission", StringComparison.OrdinalIgnoreCase) ||
                     ex.Message.Contains("NotAllowed", StringComparison.OrdinalIgnoreCase)
                ? "Camera access was blocked. Allow the camera for this site, or use a USB scanner."
                : ex.Message.Contains("NotFound", StringComparison.OrdinalIgnoreCase)
                    ? "No camera was found. Connect one, or use a USB scanner."
                    : ex.Message.Split('\n')[0];
        }
        finally
        {
            _starting = false;
            StateHasChanged();
        }
    }

    public async Task StopAsync()
    {
        _running = false;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _video);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OnQrCode(string text) => InvokeAsync(() => OnCode.InvokeAsync(text));

    public async ValueTask DisposeAsync()
    {
        try
        {
            await StopAsync();

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser stops the camera with the page.
        }

        _self?.Dispose();
    }
}
