<div class="if-stat @(string.IsNullOrEmpty(Tone) ? "" : $"tone-{Tone}")">
    <div class="if-stat-label">@Label</div>
    <div class="if-stat-value">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Sub))
    {
        <div class="if-stat-sub">@Sub</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public string? Sub { get; set; }

    /// <summary>accent, success, warning, danger or info.</summary>
    [Parameter] public string? Tone { get; set; }
}
