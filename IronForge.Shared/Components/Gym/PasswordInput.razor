@* A password box with a Show/Hide button, e.g. for mobile users checking what they typed. *@

<div class="if-password">
    <input id="@Id"
           type="@(_visible ? "text" : "password")"
           autocomplete="@Autocomplete"
           autocapitalize="off"
           spellcheck="false"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnChangeAsync" />
    <button type="button"
            class="if-password-toggle"
            aria-label="@(_visible ? "Hide password" : "Show password")"
            aria-pressed="@_visible"
            @onclick="() => _visible = !_visible">
        @(_visible ? "Hide" : "Show")
    </button>
</div>

@code {
    [Parameter] public string? Id { get; set; }

    [Parameter] public string Value { get; set; } = "";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Autocomplete { get; set; } = "current-password";

    [Parameter] public string? Placeholder { get; set; }

    private bool _visible;

    private Task OnChangeAsync(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
